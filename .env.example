POSTGRES_USER=phrasefluency
POSTGRES_PASSWORD=changeme
POSTGRES_DB=phrasefluency

SESSION_SECRET=changeme-generate-a-long-random-value
OPENAI_API_KEY=
# Optional overrides — defaults are gpt-4o-mini / 30s if unset.
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
ENVIRONMENT=development

# Bootstrapped once at startup if no matching user exists yet.
# This is how the creator/admin account is provisioned in closed, admin-only V1 registration.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
